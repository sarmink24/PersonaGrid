PORT=4000
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/personagrid"
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_random_64_byte_hex_string"
ADMIN_JWT_SECRET="CHANGE_ME_generate_a_different_random_64_byte_hex_string"

# Groq (required for AI features)
GROQ_API_KEY="your-groq-api-key-here"

# Email (required for password reset)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"

# Admin Setup (required for seed scripts)
ADMIN_EMAIL=admin@personagrid.com
ADMIN_PASSWORD="use-a-strong-password-at-least-12-chars"
